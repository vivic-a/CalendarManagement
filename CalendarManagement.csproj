<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="CalendarManagementAppService\**" />
    <Compile Remove="CalendarManagementDataService\**" />
    <Compile Remove="CalendarManagementModels\**" />
    <EmbeddedResource Remove="CalendarManagementAppService\**" />
    <EmbeddedResource Remove="CalendarManagementDataService\**" />
    <EmbeddedResource Remove="CalendarManagementModels\**" />
    <None Remove="CalendarManagementAppService\**" />
    <None Remove="CalendarManagementDataService\**" />
    <None Remove="CalendarManagementModels\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="CalendarManagementAppService\CalendarManagementAppService.csproj" />
    <ProjectReference Include="CalendarManagementModels\CalendarManagementModels.csproj" />
  </ItemGroup>

	<ItemGroup>
		<Compile Remove="calendar\**" />
		<EmbeddedResource Remove="calendar\**" />
		<None Remove="calendar\**" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="appsettings.Development.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
	    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	  </Content>
	  <Content Include="appsettings.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
	    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="calendar\**" />
		<EmbeddedResource Remove="calendar\**" />
		<None Remove="calendar\**" />
	</ItemGroup>

</Project>
